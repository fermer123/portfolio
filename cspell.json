{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "import": ["@cspell/dict-ru_ru/cspell-ext.json"],
  "language": "en,ru,ru-ru",
  "useGitignore": true,
  "validateDirectives": true,
  "maxNumberOfProblems": 200,
  "words": [
    "AXENIX",
    "BFT",
    "HABR",
    "Habr",
    "Fortum",
    "i18next",
    "Lngs",
    "MITI",
    "Mantine",
    "microfrontend",
    "microfrontends",
    "opsz",
    "Smolin",
    "TanStack",
    "wght",
    "Zod",
    "Инфокоммуникационные",
    "Микрофронтенд",
    "Микрофронтенда",
    "Микрофронтендами",
    "Микрофронтенды",
    "Микрофронтенд-архитектуры",
    "Микросервисов",
    "Микросервисы",
    "Высоконагруженные",
    "высоконагруженные",
    "микрофронтенд",
    "микрофронтенда",
    "микрофронтендами",
    "микрофронтенды",
    "fermer"
  ],
  "flagWords": ["Javascript", "Typescript", "Postgresql", "Reactjs"],
  "ignorePaths": [
    "cspell.json",
    "node_modules/**",
    "dist/**",
    "package-lock.json",
    "public/Igor-Smolin-CV.pdf",
    "public/favicon.ico"
  ]
}
